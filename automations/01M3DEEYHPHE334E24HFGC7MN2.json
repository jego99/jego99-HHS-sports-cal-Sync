        "actionName": "agent.ask",
        "input": {
          "input": "Create the upcoming week's Activities Hub list from the master calendar export below. Use the week beginning on the next Monday after the Sunday run, include only dated events in that week, group items by date, and include activity name, event title, time, location, and notes when present. If the calendar has no dated events for that week, say that clearly and do not invent events. Return only a concise plain-text list suitable for the weekly activities page. Master calendar export: {{ c2f94d61-a7bf-4f7f-8b7d-4e7a4f4a8f22[\"content\"] }}",
          "agentId": {
            "type": "flow-template-variable-input-type",
            "id": "01M3DED0CN4FZCHGC8CBEXP1J3"
          },
          "outputType": "plaintext"
        }
      }
    },
    {
